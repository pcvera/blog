---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION } from "../consts";
import "@pcvera-puzzles/hexagonal-grids/hexagon.css";
import "@pcvera-puzzles/hexagonal-grids/offset-grid.css";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Peter's blog" description={SITE_DESCRIPTION} />
    <style>
      main {
        width: 960px;
      }
      ul {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
        list-style-type: none;
        margin: 0;
        padding: 0;
      }
      ul li * {
        text-decoration: none;
        transition: 0.2s ease;
      }
      ul li a {
        display: block;
      }
      .hex-photo {
        display: block;
        background: rgb(var(--black));
      }
      .hex-photo .hex-photo-img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        transform: scale(1.1);
        transform-origin: center center;
        transition: transform 0.35s ease;
      }
      ul li a:hover .hex-photo .hex-photo-img {
        transform: scale(1);
      }
      .title-container {
        width: 100%;
        height: 50%;
        position: absolute;
        left: 0;
        right: 0;
        bottom: 25%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        /* Center-weighted scrim: matches flex-centered title + date */
        background: linear-gradient(
          180deg,
          transparent 0%,
          rgba(var(--black), 0.3) 20%,
          rgba(var(--black), 0.3) 80%,
          transparent 100%
        );
      }

      .title {
        margin: 0;
        color: #fff;
        line-height: 1.2;
        font-weight: 700;
        text-shadow:
          0 2px 2px rgba(0, 0, 0, 0.75),
          0 0 1em rgba(0, 0, 0, 0.45);
      }
      .title-container .title {
        transform: scale(1);
        transform-origin: center center;
        transition: transform 0.15s ease;
      }
      .title-container .date {
        margin: 0.35rem 0 0;
        color: rgba(255, 255, 255, 1);
        text-shadow: 0 2px 2px rgba(0, 0, 0, 0.65);
      }
      ul li a:hover .title-container .title {
        transform: scale(1.06);
      }
      .post-link {
        width: var(--hex-width);
        height: var(--hex-height);
      }

      @media (max-width: 720px) {
        ul {
          gap: 0.5em;
        }
        ul li {
          width: 100%;
          text-align: center;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="pointy-top">
      <section
        class="offset-grid pointy-top"
        style={{
          "--hex-size": "300px",
          "--gap": "100px",
          "--row-count": Math.ceil((posts.length * 2) / 5),
          "--col-count": 3,
          position: "relative",
        }}
      >
        <ul>
          {
            posts.map((post, index) => (
              <li>
                <a
                  class="placed-hex post-link"
                  style={`--r: 0; --q: ${index};`}
                  href={`/posts/${post.id}/`}
                >
                  {post.data.heroImage && (
                    <span class="hexagon-clip hex-photo">
                      <Image
                        width={960}
                        height={540}
                        src={post.data.heroImage}
                        alt=""
                        class="hex-photo-img"
                      />
                    </span>
                  )}
                  <div class="title-container">
                    <h4 class="title">{post.data.title}</h4>
                    <p class="date">
                      <FormattedDate date={post.data.pubDate} />
                    </p>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>
